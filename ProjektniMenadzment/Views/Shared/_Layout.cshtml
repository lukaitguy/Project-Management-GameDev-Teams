@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    string title = (ViewData["Title"] as string) ?? "ProjektniMenadzment";

    // helper za 'active' klasu
    string Active(string controller, string? action = null)
    {
        var rd = ViewContext.RouteData.Values;
        var c = (rd["controller"]?.ToString() ?? "").ToLowerInvariant();
        var a = (rd["action"]?.ToString() ?? "").ToLowerInvariant();
        bool match = (c == controller.ToLowerInvariant()) && (action == null || a == action.ToLowerInvariant());
        return match ? "active" : "";
    }

    bool isSignedIn = SignInManager.IsSignedIn(User);
    bool isAdminOrPM = User.IsInRole("Administrator") || User.IsInRole("ProjektniMenadzer");
    var displayName = isSignedIn ? (User?.Identity?.Name ?? "Korisnik") : "";
}

<!doctype html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title - ProjektniMenadzment</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .navbar-brand {
        font-weight: 700;
        letter-spacing: .2px;
        }

        .navbar-dark .nav-link {
        color: rgba(255,255,255,.85);
        }

        .navbar-dark .nav-link.active, .navbar-dark .nav-link:hover {
        color: #fff;
        }

        .footer-min {
        color: #6b7280;
        }

        .toast-container {
        z-index: 1080;
        }
    </style>
    @RenderSection("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🎮 PM za Game Dev</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Meni">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (isSignedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Projekti","Index")" asp-controller="Projekti" asp-action="Index">Projekti</a>
                            </li>
                            @if (isAdminOrPM)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Active("Resursi")" href="#" id="adminDrop" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Admin
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Resursi" asp-action="Index">Resursi</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminKorisnici" asp-action="Index">Korisnici</a></li>
                                        <li><a class="dropdown-item" asp-controller="Projekti" asp-action="Reports">Izvestaji</a></li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Home","Index")" asp-controller="Home" asp-action="Index">Pocetna</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Home","About")" asp-controller="Home" asp-action="About">O nama</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Home","Contact")" asp-controller="Home" asp-action="Contact">Kontakt</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex">
                        @if (isSignedIn)
                        {
                            <div class="dropdown">
                                <a class="btn btn-outline-light dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @displayName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Projekti" asp-action="Index">Moji projekti</a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Manage">Profil</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="get" class="px-3 py-1">
                                            <button class="btn btn-sm btn-outline-danger w-100">Odjava</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light me-2" asp-controller="Account" asp-action="Login">Prijava</a>
                            <a class="btn btn-light text-dark" asp-controller="Account" asp-action="Register">Registracija</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- FLASH PORUKE (TempData["Success"/"Error"]) -->
    <div class="toast-container position-fixed top-0 end-0 p-3">
        @if (TempData["Success"] is string sMsg)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">@sMsg</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string eMsg)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">@eMsg</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <!-- PAGE WRAPPER -->
    <div class="container my-4 flex-grow-1">
        @* optionalna traka za breadcrumbs i header akcije *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                @RenderSection("Breadcrumbs", required: false)
            </div>
            <div class="d-flex gap-2">
                @RenderSection("HeaderActions", required: false)
            </div>
        </div>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="mt-auto border-top py-4">
        <div class="container d-flex flex-wrap align-items-center justify-content-between">
            <div class="small text-muted">© @DateTime.Now.Year Projektni Menadžment za Game Dev timove — by Luka Djukic · ITS</div>
            <div class="d-flex gap-3 small">
                <a class="text-decoration-none footer-min" asp-controller="Home" asp-action="Index">Pocetna</a>
                @if (!isSignedIn)
                {
                    <a class="text-decoration-none footer-min" asp-controller="Account" asp-action="Login">Prijava</a>
                    <a class="text-decoration-none footer-min" asp-controller="Account" asp-action="Register">Registracija</a>
                }
                <a class="text-decoration-none footer-min" href="#">Politika privatnosti</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // auto-hide toasts posle 4s
        window.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.toast').forEach(t => {
                const toast = new bootstrap.Toast(t, { delay: 4000 });
                toast.show();
            });
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

