@* Views/Home/Index.cshtml — Public landing page (unauthenticated) *@
@{
    ViewData["Title"] = "Dobrodošli";
}

<style>
    .hero {
        background: radial-gradient(1200px 500px at -10% -20%, rgba(99,102,241,.20), transparent), radial-gradient(900px 400px at 110% 10%, rgba(16,185,129,.18), transparent), linear-gradient(180deg, #0f172a 0%, #111827 100%);
        color: #fff;
        border-radius: 1.25rem;
        overflow: hidden;
        position: relative;
        isolation: isolate;
    }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='1200' height='600' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='rgba(255,255,255,.05)'%3E%3Cpath d='M0 520 C300 460, 900 640, 1200 520'/%3E%3Cpath d='M0 420 C300 360, 900 540, 1200 420'/%3E%3Cpath d='M0 320 C300 260, 900 440, 1200 320'/%3E%3C/g%3E%3C/svg%3E");
            background-size: cover;
            opacity: .6;
            pointer-events: none;
        }

    .btn-glow {
        box-shadow: 0 8px 24px rgba(99,102,241,.35);
    }

    .feature-card {
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 1rem;
        padding: 1.25rem;
        background: #fff;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .feature-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
        }

    .tag {
        display: inline-block;
        padding: .2rem .6rem;
        border-radius: 999px;
        font-size: .75rem;
        background: #f1f5f9;
        color: #0f172a;
    }

    .screenshot {
        border-radius: 1rem;
        border: 1px solid rgba(255,255,255,.15);
        background: linear-gradient(180deg, rgba(15,23,42,.9), rgba(17,24,39,.9)), radial-gradient(800px 220px at 20% 0%, rgba(99,102,241,.18), transparent), radial-gradient(600px 200px at 90% 20%, rgba(16,185,129,.18), transparent);
        height: 320px;
        position: relative;
        overflow: hidden;
    }

        .screenshot .bar {
            height: 36px;
            background: rgba(255,255,255,.06);
            display: flex;
            align-items: center;
            gap: .4rem;
            padding-left: .8rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

    .dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

        .dot.red {
            background: #ef4444
        }

        .dot.yellow {
            background: #f59e0b
        }

        .dot.green {
            background: #22c55e
        }

    .fake-row {
        display: flex;
        gap: .75rem;
        padding: .75rem
    }

    .fake-col {
        flex: 1;
        background: rgba(255,255,255,.06);
        height: 14px;
        border-radius: 6px;
    }

    .price-card {
        border: 1px solid rgba(0,0,0,.08);
        border-radius: 1rem;
        background: #fff;
        padding: 1.5rem;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .price-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 34px rgba(0,0,0,.09);
        }

    .faq .accordion-button:focus {
        box-shadow: none;
    }

    .footer-min {
        color: #475569;
    }
</style>

<div class="container py-4 py-lg-5">

    <!-- HERO -->
    <section class="hero p-4 p-lg-5 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="tag mb-3">Platforma za timove u razvoju igara</span>
                <h1 class="fw-bold mb-3">
                    Sve što vam treba za razvoj <span class="text-info">igre</span> — na jednom mestu.
                </h1>
                <p class="lead mb-4" style="color:#e5e7eb;">
                    Planirajte sprintove, dodeljujte zadatke, pratite resurse i budžet, pišite komentare — i isporučite igru na vreme.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a class="btn btn-light btn-lg btn-glow" href="@Url.Action("Register","Account")">Započni besplatno</a>
                    <a class="btn btn-outline-light btn-lg" href="@Url.Action("Login","Account")">Prijava</a>
                </div>
                <div class="d-flex gap-4 mt-4" style="color:#cbd5e1;">
                    <div><strong>Bez kartice</strong> · probni period</div>
                    <div><strong>Open-source ekstenzije</strong> · webhookovi</div>
                </div>
            </div>
            <div class="col-lg-6 mt-4 mt-lg-0">
                <div class="screenshot text-white">
                    <div class="bar">
                        <div class="dot red"></div><div class="dot yellow"></div><div class="dot green"></div>
                        <span class="ms-2" style="opacity:.8;">Pregled projekta · Space Game</span>
                    </div>
                    <div class="p-3">
                        <div class="fake-row"><div class="fake-col" style="flex:2"></div><div class="fake-col"></div><div class="fake-col"></div></div>
                        <div class="fake-row"><div class="fake-col" style="flex:1.5"></div><div class="fake-col" style="flex:2"></div></div>
                        <div class="fake-row"><div class="fake-col" style="flex:2.5"></div><div class="fake-col"></div></div>
                        <div class="fake-row"><div class="fake-col"></div><div class="fake-col" style="flex:2"></div><div class="fake-col"></div></div>
                        <div class="fake-row"><div class="fake-col" style="flex:2"></div><div class="fake-col"></div></div>
                    </div>
                </div>
                <div class="text-end mt-2" style="color:#cbd5e1;"><small>Mock screenshot (bez pravih podataka)</small></div>
            </div>
        </div>
    </section>

    <!-- TRUST / LOGOS (placeholder) -->
    <section class="mb-5">
        <div class="text-center text-muted mb-3">Veruju nam indie timovi i studentski studio programi</div>
        <div class="d-flex justify-content-center flex-wrap gap-4 opacity-75">
            <span class="fw-semibold">PIXELFORGE</span>
            <span class="fw-semibold">LUDUS LAB</span>
            <span class="fw-semibold">NOVA DEV</span>
            <span class="fw-semibold">STUDENT GAME HUB</span>
        </div>
    </section>

    <!-- FEATURES -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <span class="tag">Funkcionalnosti</span>
            <h2 class="mt-2">Skrojeno za game dev timove</h2>
            <p class="text-muted mb-0">Od GDD-a do shippovanja — svi koraci pod kontrolom.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="fs-4 mb-2">✅</div>
                    <h6>Kanban & sprint zadaci</h6>
                    <p class="text-muted mb-0">Statusi, prioriteti, rokovi, dodela po ulozi (designer, dev, QA).</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="fs-4 mb-2">💬</div>
                    <h6>Komentari & mention</h6>
                    <p class="text-muted mb-0">Diskutujte uz zadatak, spomenite člana i dobijte notifikaciju.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="fs-4 mb-2">🧩</div>
                    <h6>Resursi & budžet</h6>
                    <p class="text-muted mb-0">Evidencija asseta i troškova; grafik iskorišćenosti budžeta.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card h-100">
                    <div class="fs-4 mb-2">📊</div>
                    <h6>Izveštaji napretka</h6>
                    <p class="text-muted mb-0">Burn-down, status po timu i projektu, kašnjenja i rizici.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="mb-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <h3 class="mb-3">Kako funkcioniše?</h3>
                <div class="d-flex gap-3 mb-3">
                    <div class="badge bg-dark rounded-pill">1</div>
                    <div>
                        <strong>Kreiraj studio i projekte</strong>
                        <div class="text-muted">Dodaj članove tima i definiši ciljeve po milestone-ima.</div>
                    </div>
                </div>
                <div class="d-flex gap-3 mb-3">
                    <div class="badge bg-dark rounded-pill">2</div>
                    <div>
                        <strong>Razbij zadatke po ulogama</strong>
                        <div class="text-muted">Art, gameplay, zvuk, mreža — svako zna svoj backlog.</div>
                    </div>
                </div>
                <div class="d-flex gap-3">
                    <div class="badge bg-dark rounded-pill">3</div>
                    <div>
                        <strong>Merite napredak & troškove</strong>
                        <div class="text-muted">Izveštaji i grafikoni koji prate realno stanje produkcije.</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 order-first order-lg-last">
                <div class="screenshot text-white">
                    <div class="bar">
                        <div class="dot red"></div><div class="dot yellow"></div><div class="dot green"></div>
                        <span class="ms-2" style="opacity:.8;">Sprint board · Zombie Shooter</span>
                    </div>
                    <div class="p-3">
                        <div class="fake-row"><div class="fake-col" style="flex:1.2"></div><div class="fake-col" style="flex:2.2"></div></div>
                        <div class="fake-row"><div class="fake-col" style="flex:2.4"></div><div class="fake-col"></div><div class="fake-col"></div></div>
                        <div class="fake-row"><div class="fake-col"></div><div class="fake-col" style="flex:2"></div></div>
                        <div class="fake-row"><div class="fake-col" style="flex:2.6"></div><div class="fake-col"></div></div>
                    </div>
                </div>
                <div class="text-end mt-2 text-muted"><small>Vizuelizacija — primer makete</small></div>
            </div>
        </div>
    </section>

    <!-- PRICING (simple) -->
    <section class="mb-5">
        <div class="text-center mb-4">
            <span class="tag">Cene</span>
            <h2 class="mt-2">Jednostavno i fer</h2>
        </div>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="price-card h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5>Indie</h5><span class="tag">Najpopularnije</span>
                    </div>
                    <div class="display-6 fw-bold mb-2">0€</div>
                    <p class="text-muted">Za solo i male timove koji tek počinju.</p>
                    <ul class="mb-3">
                        <li>Do 2 projekta</li>
                        <li>Besplatni zadaci i komentari</li>
                        <li>Osnovni izveštaji</li>
                    </ul>
                    <a class="btn btn-dark w-100" href="@Url.Action("Register","Account")">Kreni besplatno</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="price-card h-100">
                    <h5>Studio</h5>
                    <div class="display-6 fw-bold mb-2">9€<small class="fs-6 text-muted">/kor.</small></div>
                    <p class="text-muted">Za timove koji rade aktivnu produkciju.</p>
                    <ul class="mb-3">
                        <li>Neograničeni projekti</li>
                        <li>Napredni izveštaji i budžet</li>
                        <li>Notifikacije & integracije</li>
                    </ul>
                    <a class="btn btn-outline-dark w-100" href="@Url.Action("Register","Account")">Zatraži probu</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="price-card h-100">
                    <h5>Publisher</h5>
                    <div class="display-6 fw-bold mb-2">Kontakt</div>
                    <p class="text-muted">Za veće studije i izdavače.</p>
                    <ul class="mb-3">
                        <li>Custom SLA & SSO</li>
                        <li>Više timova & projekata</li>
                        <li>Namenska podrška</li>
                    </ul>
                    <a class="btn btn-outline-dark w-100" href="@Url.Action("Login","Account")">Razgovarajmo</a>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="faq mb-5">
        <div class="text-center mb-3">
            <span class="tag">FAQ</span>
            <h2 class="mt-2">Česta pitanja</h2>
        </div>
        <div class="accordion" id="faq">
            <div class="accordion-item">
                <h2 class="accordion-header" id="f1">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#c1">Da li moram karticu za probu?</button>
                </h2>
                <div id="c1" class="accordion-collapse collapse show" data-bs-parent="#faq">
                    <div class="accordion-body">
                        Ne. Registruj se i odmah testiraj platformu bez kartice.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="f2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#c2">Da li podržavate studentske timove?</button>
                </h2>
                <div id="c2" class="accordion-collapse collapse" data-bs-parent="#faq">
                    <div class="accordion-body">
                        Da, postoji posebna pogodnost za studentske projekte — pišite nam nakon registracije.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header" id="f3">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#c3">Imate li integracije?</button>
                </h2>
                <div id="c3" class="accordion-collapse collapse" data-bs-parent="#faq">
                    <div class="accordion-body">
                        Webhookovi i otvoren API za CI/CD, repozitorijume i chat alate. Više integracija stiže uskoro.
                    </div>
                </div>
            </div>
        </div>
    </section>


</div>
