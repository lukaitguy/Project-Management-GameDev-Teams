@model ProjektniMenadzment.Models.ViewModels.RegisterViewModel;
@{
}

<div class="container mx-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <h1 class="mb-3 h3">
                Registracija
            </h1>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Ime</label>
                    <input type="text" id="ime" class="form-control" asp-for="Ime" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Prezime</label>
                    <input type="text" id="prezime" class="form-control" asp-for="Prezime" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Korisnicko ime</label>
                    <input type="text" id="username" class="form-control" asp-for="UserName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" id="email" class="form-control" asp-for="Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input type="password" id="password" class="form-control" asp-for="Password"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Broj telefona</label>
                    <input type="text" id="brojTel" class="form-control" asp-for="BrojTelefona" />
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-dark">Registruj se</button>
                </div>
            </form>

        </div>
    </div>
</div>