@using ProjektniMenadzment.Models.ViewModels
@model PregledProjektaViewModel
@{
    ViewData["Title"] = "Pregled projekta";

    var ukupno = Model.Zadaci?.Count ?? 0;
    var zavrseni = Model.Zadaci?.Count(z => z.Status == "Zavrsen") ?? 0;
    var procenat = ukupno > 0 ? (int)Math.Round((double)zavrseni / ukupno * 100) : 0;

    var danas = DateOnly.FromDateTime(DateTime.Now);
    var probijeniRokovi = Model.Zadaci?.Count(z => z.Rok.HasValue && z.Rok.Value < danas && z.Status != "Zavrsen") ?? 0;

    var ukupniTroskovi = Model.Resursi?.Sum(r => r.Cena ?? 0) ?? 0m;
    var budzet = Model.Budzet > 0 ? Model.Budzet : 0m;
    var procenatBudzet = budzet > 0 ? (int)Math.Round((double)(ukupniTroskovi / budzet * 100)) : 0;

	var kasni = Model.Zadaci?.Count(z => z.Rok.HasValue && z.Rok.Value < danas && z.Status != "Zavrsen") ?? 0;
    string StatusBadge(string s) => s switch
    {
        "Planiran" => "bg-secondary",
        "U toku" => "bg-info text-dark",
        "Pauziran" => "bg-warning text-dark",
        "Otkazan" => "bg-danger",
        "Zavrsen" => "bg-success",
        _ => "bg-light text-dark"
    };
}
@if (User.IsInRole("Administrator") || User.IsInRole("ProjektniMenadzer"))
{
    <style>
        .card-soft {
        border: 1px solid rgba(0,0,0,.06);
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
        border-radius: 1rem;
        }

        .progress.thin {
        height: .6rem;
        }

        .chip {
        display: inline-block;
        padding: .15rem .5rem;
        border-radius: 999px;
        background: #f1f5f9;
        font-size: .8rem;
        }

        .table-sm td, .table-sm th {
        vertical-align: middle;
        }

        .empty {
        color: #6b7280;
        }
    </style>

    <div class="container my-4">

        <!-- HEADER -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="mb-2">
                <h2 class="mb-1">🎮 @Model.Naziv</h2>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
                    <span class="chip"><strong>Pocetak:</strong> @Model.DatumPocetka:dd.MM.yyyy</span>
                    <span class="chip"><strong>Rok:</strong> @(Model.Rok?.ToString("dd.MM.yyyy") ?? "—")</span>
                    <span class="chip"><strong>Kreirao:</strong> @Model.KreiraoKorisnikIme</span>
                    <span class="chip"><strong>Zanr:</strong> @Model.Zanr</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                @if (User.IsInRole("Administrator") || User.IsInRole("ProjektniMenadzer"))
                {
                    <a asp-controller="Zadaci" asp-action="Create" asp-route-projekatId="@Model.Id" class="btn btn-dark">➕ Zadatak</a>
                    <a asp-controller="Projekti" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark">✏️ Uredi</a>
                }
                <a asp-controller="Projekti" asp-action="Index" class="btn btn-outline-secondary">← Nazad</a>
            </div>
        </div>

        <!-- KPI STAT KARTICE -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card card-soft p-3 h-100">
                    <div class="text-muted">Zadaci ukupno</div>
                    <div class="h3 fw-bold mb-0">@ukupno</div>
                    <div class="progress thin mt-2"><div class="progress-bar" style="width:@procenat%"></div></div>
                    <small class="text-muted">Završeno: @zavrseni (@procenat%)</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-soft p-3 h-100">
                    <div class="text-muted">Probijeni rokovi</div>
                    <div class="h3 fw-bold mb-0 @(probijeniRokovi>0?"text-danger":"")">@probijeniRokovi</div>
                    <small class="text-muted">Do danasnjeg datuma</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-soft p-3 h-100">
                    <div class="text-muted">Budžet</div>
                    <div class="fw-bold">@budzet.ToString("C")</div>
                    <small class="text-muted">Planirano</small>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card card-soft p-3 h-100">
                    <div class="text-muted">Troškovi</div>
                    <div class="fw-bold">@ukupniTroskovi.ToString("C")</div>
                    <div class="progress thin mt-2">
                        <div class="progress-bar @(procenatBudzet>100?"bg-danger":"")" style="width:@Math.Clamp(procenatBudzet,0,100)%"></div>
                    </div>
                    <small class="text-muted">Iskorišćen budžet: @procenatBudzet%</small>
                </div>
            </div>
        </div>

        <!-- OPIS & NAPREDAK -->
        <div class="row g-3 mb-4">
            <div class="col-lg-6">
                <div class="card card-soft p-3 h-100">
                    <h5 class="mb-2">Napredak projekta</h5>
                    <div class="progress" style="height: 1.1rem;">
                        <div class="progress-bar bg-success" role="progressbar" style="width:@procenat%;">@procenat%</div>
                    </div>
                    <div class="d-flex gap-3 mt-2 text-muted">
                        <span>✅ Zavrseno: <strong>@zavrseni</strong></span>
                        <span>🧩 Aktivno: <strong>@(ukupno - zavrseni)</strong></span>
                        <span>⏰ Kasni: <strong class="@(probijeniRokovi>0?"text-danger":"")">@probijeniRokovi</strong></span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card card-soft p-3 h-100">
                    <h5 class="mb-2">Opis</h5>
                    <div class="text-muted">@Model.Opis</div>
                </div>
            </div>
        </div>

        <!-- TABOVI: Zadaci / Članovi / Resursi / Analitika -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-zadaci" type="button" role="tab">Zadaci</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-clanovi" type="button" role="tab">Clanovi tima</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-resursi" type="button" role="tab">Resursi</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-analitika" type="button" role="tab">Analitika</button>
            </li>
        </ul>

        <div class="tab-content">

            <!-- ZADACI -->
            <div class="tab-pane fade show active" id="tab-zadaci" role="tabpanel">
                <div class="card card-soft p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Zadaci projekta</h5>
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index","Zadaci", new { projekatId = Model.Id })">Vidi sve</a>
                    </div>

                    @if (Model.Zadaci?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naslov</th>
                                        <th>Status</th>
                                        <th>Rok</th>
                                        <th>Dodeljen</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var zad in Model.Zadaci.OrderByDescending(z => z.DatumKreiranja).Take(10))
                                    {
                                        <tr>
                                            <td class="fw-semibold">@zad.Naslov</td>
                                            <td><span class="badge @StatusBadge(zad.Status)">@zad.Status</span></td>
                                            <td>@(zad.Rok?.ToString("dd.MM.yyyy") ?? "—")</td>
                                            <td>@zad.DodeljenKorisnikuIme</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty">Nema zadataka.</div>
                    }
                </div>
            </div>

            <!-- ČLANOVI -->
            <div class="tab-pane fade" id="tab-clanovi" role="tabpanel">
                <div class="card card-soft p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Clanovi tima</h5>
                        <a asp-action="AddMember" asp-route-id="@Model.Id" class="btn btn-sm btn-dark">➕ Dodaj clana</a>
                    </div>
                    @if (Model.Clanovi?.Any() == true)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var clan in Model.Clanovi)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@clan.Ime @clan.Prezime</div>
                                        <small class="text-muted">Uloga: @clan.Uloga</small>
                                    </div>
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Zadaci" asp-action="Index" asp-route-projekatId="@Model.Id">Zadaci</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="empty">Nema članova u timu.</div>
                    }
                </div>
            </div>

            <!-- RESURSI -->
            <div class="tab-pane fade" id="tab-resursi" role="tabpanel">
                <div class="card card-soft p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="mb-0">Resursi</h5>
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index","Resursi")">Svi resursi</a>
                    </div>
                    @if (Model.Resursi?.Any() == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Tip</th>
                                        <th>Cena</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in Model.Resursi)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@r.Naziv</td>
                                            <td>@r.Tip</td>
                                            <td>@(r.Cena?.ToString("C") ?? "0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty">Nema dodeljenih resursa ovom projektu.</div>
                    }
                </div>
            </div>

            <!-- ANALITIKA -->
            <div class="tab-pane fade" id="tab-analitika" role="tabpanel">
                <div class="card card-soft p-3">
                    <h5 class="mb-3">Ucinak clanova tima</h5>
                    @if (Model.Zadaci?.Any(z => z.DodeljenKorisnikuIme != "Nije dodeljen") == true)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Clan tima</th>
                                        <th>Ukupno zadataka</th>
                                        <th>Zavrseni</th>
                                        <th>Stopa (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var g in Model.Zadaci
                                  .Where(z => z.DodeljenKorisnikuIme != "Nije dodeljen")
                                  .GroupBy(z => z.DodeljenKorisnikuIme))
                                    {
                                        var uk = g.Count();
                                        var zv = g.Count(z => z.Status == "Zavrsen");
                                        var st = uk > 0 ? (int)Math.Round((double)zv / uk * 100) : 0;
                                        <tr>
                                            <td>@g.Key</td>
                                            <td>@uk</td>
                                            <td>@zv</td>
                                            <td>
                                                <div class="progress thin">
                                                    <div class="progress-bar bg-success" style="width:@st%"></div>
                                                </div>
                                                <small class="text-muted">@st%</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty">Nema dodeljenih zadataka članovima.</div>
                    }
                </div>
            </div>

        </div>
    </div>
}
else
{
    <style>
        .card-soft {
            border: 1px solid rgba(0,0,0,.06);
            box-shadow: 0 8px 24px rgba(0,0,0,.06);
            border-radius: 1rem
        }

        .chip {
            display: inline-block;
            padding: .15rem .5rem;
            border-radius: 999px;
            background: #f1f5f9;
            font-size: .8rem
        }

        .muted {
            color: #6b7280
        }

        .table-sm td, .table-sm th {
            vertical-align: middle
        }

        .progress.thin {
            height: .6rem
        }
    </style>

    <div class="container my-4">
        <!-- HEADER (samo osnove + nazad) -->
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
            <div class="mb-2">
                <h2 class="mb-1">🎮 @Model.Naziv</h2>
                <div class="d-flex gap-2 flex-wrap">
                    <span class="badge @StatusBadge(Model.Status)">@Model.Status</span>
                    <span class="chip"><strong>Pocetak:</strong> @Model.DatumPocetka:dd.MM.yyyy</span>
                    <span class="chip"><strong>Rok:</strong> @(Model.Rok?.ToString("dd.MM.yyyy") ?? "—")</span>
                    <span class="chip"><strong>Zanr:</strong> @Model.Zanr</span>
                </div>
            </div>
            <a asp-controller="Projekti" asp-action="Index" class="btn btn-outline-secondary">← Nazad</a>
        </div>

        <!-- MINI KPI -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4">
                <div class="card card-soft p-3 h-100">
                    <div class="muted">Zadaci ukupno</div>
                    <div class="h3 fw-bold mb-0">@ukupno</div>
                    <div class="progress thin mt-2"><div class="progress-bar" style="width:@procenat%"></div></div>
                    <small class="muted">Zavrseno: @zavrseni (@procenat%)</small>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card card-soft p-3 h-100">
                    <div class="muted">Aktivni</div>
                    <div class="h3 fw-bold mb-0">@Math.Max(0, ukupno - zavrseni)</div>
                    <small class="muted">U toku / ne-zavrseni</small>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card card-soft p-3 h-100">
                    <div class="muted">Kasni</div>
                    <div class="h3 fw-bold mb-0 @(kasni>0?"text-danger":"")">@kasni</div>
                    <small class="muted">Istekao rok</small>
                </div>
            </div>
        </div>

        <!-- OPIS (kratko) -->
        <div class="card card-soft p-3 mb-3">
            <h5 class="mb-2">Opis</h5>
            <div class="muted">@(!string.IsNullOrWhiteSpace(Model.Opis) ? Model.Opis : "—")</div>
        </div>

        <!-- LISTA ZADATAKA (samo osnovno + user akcije) -->
        <div class="card card-soft p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Zadaci</h5>
                <a class="btn btn-sm btn-outline-secondary"
                   href="@Url.Action("Index","Zadaci", new { projekatId = Model.Id })">Vidi sve</a>
            </div>

            @if (Model.Zadaci?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Naslov</th>
                                <th>Status</th>
                                <th>Rok</th>
                                <th>Dodeljen</th>
                                <th class="text-end">Akcije</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var z in Model.Zadaci.OrderByDescending(x => x.DatumKreiranja))
                            {
                                bool kasniZ = z.Rok.HasValue && z.Rok.Value < danas && z.Status != "Zavrsen";
                                <tr>
                                    <td class="fw-semibold">@z.Naslov</td>
                                    <td><span class="badge @StatusBadge(z.Status)">@z.Status</span></td>
                                    <td class="@(kasniZ?"text-danger fw-semibold":"")">
                                        @(z.Rok?.ToString("dd.MM.yyyy") ?? "—")
                                        @if (kasniZ)
                                        {
                                            <span class="chip ms-1">kasni</span>
                                        }
                                    </td>
                                    <td>@z.DodeljenKorisnikuIme</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1">
                                            @if (z.DodeljenKorisnikuIme == "Nije dodeljen")
                                            {
                                                <a class="btn btn-sm btn-dark"
                                                   href="@Url.Action("Claim","Zadaci", new { zadatakId = z.Id })">
                                                    Preuzmi
                                                </a>
                                            }
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="@Url.Action("Details","Zadaci", new { id = z.Id })">
                                                Pregled
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="muted">Nema zadataka.</div>
            }
        </div>
    </div>
}


