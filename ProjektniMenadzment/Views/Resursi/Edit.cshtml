@model ProjektniMenadzment.Models.ViewModels.CreateResursViewModel

@{
    ViewData["Title"] = "Uredi resurs";
}

<h2 class="mb-4">✏️ Uredi resurs</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post" class="card shadow-sm p-4">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Naziv" class="form-label fw-bold"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tip" class="form-label fw-bold"></label>
        <input asp-for="Tip" class="form-control" />
        <span asp-validation-for="Tip" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Opis" class="form-label fw-bold"></label>
        <textarea asp-for="Opis" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Cena" class="form-label fw-bold"></label>
        <input asp-for="Cena" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="ProjekatId" class="form-label fw-bold">Projekat</label>
        <select asp-for="ProjekatId" class="form-select">
            <option value="">-- Odaberi projekat --</option>
            @foreach (var p in Model.Projekti)
            {
                <option value="@p.Value" selected="@(p.Selected)">
                    @p.Text
                </option>
            }
        </select>
        <span asp-validation-for="ProjekatId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DodeljenKorisniku" class="form-label fw-bold">Dodeli korisniku</label>
        <select asp-for="DodeljenKorisniku" class="form-select">
            <option value="">-- Odaberi korisnika --</option>
            @foreach (var k in Model.Korisnici)
            {
                <option value="@k.Value" selected="@(k.Selected)">
                    @k.Text
                </option>
            }
        </select>
        <span asp-validation-for="DodeljenKorisniku" class="text-danger"></span>
    </div>

    <div class="d-flex gap-1">
        <button type="submit" class="btn btn-primary">Sacuvaj izmene</button>
        <a asp-action="Index" class="btn btn-secondary">Nazad</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
