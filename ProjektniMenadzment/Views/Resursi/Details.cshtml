@model ProjektniMenadzment.Models.ViewModels.ResursiViewModel

@{
    ViewData["Title"] = "Detalji resursa";
}

<h2 class="mb-4">📄 Detalji resursa</h2>

<div class="card shadow-sm p-4">
    <dl class="row">
        <dt class="col-sm-3">Naziv</dt>
        <dd class="col-sm-9">@Model.Naziv</dd>

        <dt class="col-sm-3">Tip</dt>
        <dd class="col-sm-9">@Model.Tip</dd>

        <dt class="col-sm-3">Opis</dt>
        <dd class="col-sm-9">@Model.Opis</dd>

        <dt class="col-sm-3">Cena</dt>
        <dd class="col-sm-9">@Model.Cena?.ToString("C")</dd>

        <dt class="col-sm-3">Projekat</dt>
        <dd class="col-sm-9">@Model.Projekat</dd>

        <dt class="col-sm-3">Dodeljen korisniku</dt>
        <dd class="col-sm-9">@Model.DodeljenKorisniku</dd>

        <dt class="col-sm-3">Datum kreiranja</dt>
        <dd class="col-sm-9">@Model.DatumKreiranja.ToString()</dd>
    </dl>

    <div class="d-flex gap-1">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Uredi</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Da li ste sigurni da zelite da obrisete resurs?');" style="display:inline;">
            <button type="submit" class="btn btn-danger">Obrisi</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Nazad</a>
    </div>

</div>

