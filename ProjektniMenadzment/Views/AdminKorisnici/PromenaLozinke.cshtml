@using ProjektniMenadzment.Models.ViewModels

@model PromenaLozinkeViewModel

<h2>Promena lozinke</h2>
<form method="post">
    <input type="hidden" asp-for="IdentityUserId" />
    <div class="mb-3">
        <label class="form-label">Nova lozinka</label>
        <input class="form-control" asp-for="NewPassword" type="password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Potvrdi lozinku</label>
        <input class="form-control" asp-for="ConfirmPassword" type="password" />
    </div>
    <button class="btn btn-primary">Sacuvaj</button>
    <a asp-action="Edit" asp-route-id="@Model.IdentityUserId" class="btn btn-outline-secondary">Nazad</a>
</form>

