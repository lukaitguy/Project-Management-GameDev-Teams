@using ProjektniMenadzment.Models.Domain
@using ProjektniMenadzment.Models.ViewModels
@model CreateZadatakRequest
@{
}
<h2>Kreiraj zadatak</h2>
<div class="container mt-3">
    <div class="row">
        <div class="col-md-12">

            <form asp-action="Create" method="post" class="card shadow-sm p-4">
                <input type="hidden" asp-for="ProjekatId" />

                <div class="form-group">
                    <label asp-for="Naslov"></label>
                    <input asp-for="Naslov" class="form-control" />
                </div>

                <div class="form-group mt-3">
                    <label asp-for="Opis"></label>
                    <textarea asp-for="Opis" class="form-control" rows="10"></textarea>
                </div>

                <div class="form-group mt-3">
                    <label asp-for="Prioritet"></label>
                    <select asp-for="Prioritet" class="form-control">
                        <option value="Nizak">Nizak</option>
                        <option value="Srednji">Srednji</option>
                        <option value="Visok">Visok</option>
                    </select>
                </div>

                <div class="form-group mt-3">
                    <label asp-for="Rok"></label>
                    <input asp-for="Rok" type="date" class="form-control" />
                </div>

                <div class="d-flex gap-1 mt-3">
                    <button type="submit" class="btn btn-dark">Kreiraj</button>
                    <a href="@Url.Action("Index", "Zadaci", new { projekatId = Model.ProjekatId })" class="btn btn-secondary">Otkazi</a>
                </div>

            </form>
        </div>
    </div>
</div>
