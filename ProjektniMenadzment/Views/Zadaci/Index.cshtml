@using Microsoft.AspNetCore.Identity
@using ProjektniMenadzment.Models.ViewModels
@inject SignInManager<IdentityUser> SignInManager

@model List<ZadaciViewModel>

@{
    ViewData["Title"] = "Zadaci";

    bool isAdminOrPM = User.IsInRole("Administrator") || User.IsInRole("ProjektniMenadzer");

    int ukupno = Model?.Count ?? 0;
    int zavrseni = Model?.Count(z => z.Status == "Zavrsen") ?? 0;
    int uToku = Model?.Count(z => z.Status == "U toku") ?? 0;

    var danas = DateOnly.FromDateTime(DateTime.Now);
    int kasni = Model?.Count(z => z.Rok.HasValue && z.Rok.Value < danas && z.Status != "Zavrsen") ?? 0;

    string StatusBadge(string s) => s switch
    {
        "Nije zapocet" => "bg-secondary",
        "U toku" => "bg-info text-dark",
        "Pauziran" => "bg-warning text-dark",
        "Otkazan" => "bg-danger",
        "Zavrsen" => "bg-success",
        _ => "bg-light text-dark"
    };

    string PrioritetBadge(string p) => p switch
    {
        "Nizak" => "bg-success",
        "Srednji" => "bg-warning text-dark",
        "Visok" => "bg-danger",
        _ => "bg-secondary"
    };
}

<style>
    .card-soft {
        border: 1px solid rgba(0,0,0,.06);
        border-radius: 1rem;
        box-shadow: 0 10px 28px rgba(0,0,0,.06);
    }

    .chip {
        display: inline-block;
        padding: .15rem .5rem;
        border-radius: 999px;
        background: #f1f5f9;
        font-size: .8rem;
    }

    .muted {
        color: #6b7280;
    }

    .table-sm td, .table-sm th {
        vertical-align: middle;
    }
</style>

<div class="container my-4">

    <!-- HEADER -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h2 class="mb-1">Zadaci — @ViewBag.NazivProjekta</h2>
            <div class="muted">Pregled zadataka u okviru projekta</div>
        </div>
        @if (isAdminOrPM)
        {
            <a class="btn btn-dark"
               href="@Url.Action("Create", "Zadaci", new { projekatId = ViewBag.ProjekatId })">
                ➕ Kreiraj
            </a>
        }
    </div>

    <!-- MINI KPI -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card card-soft p-3 h-100">
                <div class="muted">Ukupno</div>
                <div class="h4 fw-bold mb-0">@ukupno</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-soft p-3 h-100">
                <div class="muted">U toku</div>
                <div class="h4 fw-bold mb-0">@uToku</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-soft p-3 h-100">
                <div class="muted">Zavrseni</div>
                <div class="h4 fw-bold mb-0">@zavrseni</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card card-soft p-3 h-100">
                <div class="muted">Kasni</div>
                <div class="h4 fw-bold mb-0 @(kasni>0?"text-danger":"")">@kasni</div>
            </div>
        </div>
    </div>

    <!-- LISTA (TABELA) -->
    <div class="card card-soft p-3">
        @if ((Model?.Count ?? 0) == 0)
        {
            <div class="muted">Nema zadataka za ovaj projekat.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Naslov</th>
                            <th>Opis</th>
                            <th>Prioritet</th>
                            <th>Status</th>
                            <th>Rok</th>
                            <th>Dodeljen</th>
                            <th class="text-end">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var z in Model.OrderByDescending(x => x.DatumKreiranja))
                        {
                            bool isLate = z.Rok.HasValue && z.Rok.Value < danas && z.Status != "Zavrsen";
                            <tr>
                                <td class="fw-semibold">@z.Naslov</td>
                                <td class="text-truncate" style="max-width: 360px;">@z.Opis</td>
                                <td><span class="badge @PrioritetBadge(z.Prioritet)">@z.Prioritet</span></td>
                                <td><span class="badge @StatusBadge(z.Status)">@z.Status</span></td>
                                <td class="@(isLate?"text-danger fw-semibold":"")">
                                    @(z.Rok.HasValue ? z.Rok.Value.ToString("dd.MM.yyyy") : "—")
                                    @if (isLate)
                                    {
                                        <span class="ms-1 chip">kasni</span>
                                    }
                                </td>
                                <td>@z.DodeljenKorisnikuIme</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        @if (isAdminOrPM)
                                        {
                                            <a class="btn btn-sm btn-dark"
                                               href="@Url.Action("Details", "Zadaci", new { id = z.Id })">Detalji</a>
                                            <a class="btn btn-sm btn-outline-primary"
                                               href="@Url.Action("Edit", "Zadaci", new { id = z.Id })">Uredi</a>
                                            <form asp-action="Delete" asp-controller="Zadaci" method="post" class="d-inline"
                                                  onsubmit="return confirm('Obrisati zadatak?');">
                                                <input type="hidden" name="id" value="@z.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Obrisi</button>
                                            </form>
                                        }
                                        else
                                        {
                                            @* Obicni korisnik *@
                                            @if (z.DodeljenKorisnikuIme == "Nije dodeljen")
                                            {
                                                <a class="btn btn-sm btn-dark"
                                                   href="@Url.Action("Claim", "Zadaci", new { zadatakId = z.Id })">
                                                    Preuzmi
                                                </a>
                                            }
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="@Url.Action("Details", "Zadaci", new { id = z.Id })">Pregled</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="mt-3">
        <a class="btn btn-outline-secondary" asp-controller="Projekti" asp-action="Details" asp-route-id="@ViewBag.ProjekatId">← Nazad na projekat</a>
    </div>
</div>
